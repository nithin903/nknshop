<section class="section">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-heading">
        <div>
          {% if section.settings.kicker != blank %}<span class="section-kicker">{{ section.settings.kicker }}</span>{% endif %}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
    {% endif %}
    <div class="categories">
      {% for block in section.blocks %}
        <a class="category-tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Earbuds" },
        { "type": "text", "id": "text", "label": "Text", "default": "ANC & everyday" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Category grid" }]
}
{% endschema %}
