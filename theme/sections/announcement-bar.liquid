<div class="announcement-stack">
  {% for block in section.blocks %}
    <div class="announcement announcement--{{ block.settings.style }}" {{ block.shopify_attributes }}>
      <div class="page-width">{{ block.settings.text }}</div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Announcement bars",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "bar",
      "name": "Bar",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Complimentary shipping  ·  Cash on delivery  ·  Easy exchanges" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "sale", "label": "Sale" },
            { "value": "dark", "label": "Dark" },
            { "value": "trust", "label": "Trust" }
          ],
          "default": "sale"
        }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bars" }]
}
{% endschema %}
