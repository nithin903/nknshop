<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <span class="section-kicker">{{ section.settings.kicker }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_label != blank %}
        <a class="text-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
    <div class="product-grid">
      {% for block in section.blocks %}
        <article class="product-card" {{ block.shopify_attributes }}>
          <a class="product-card__media" href="{{ block.settings.url | default: routes.all_products_collection_url }}">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}">
            {% elsif block.settings.asset_image != blank %}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}">
            {% else %}
              <img src="{{ 'juicer-1.png' | asset_url }}" alt="{{ block.settings.title | escape }}">
            {% endif %}
          </a>
          <div class="product-card__body">
            <p class="vendor">NKNSHOP</p>
            <h3><a href="{{ block.settings.url | default: routes.all_products_collection_url }}">{{ block.settings.title }}</a></h3>
            <p class="price">Rs. {{ block.settings.price }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Juicers" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_image", "label": "Theme asset filename", "default": "juicer-1.png" },
        { "type": "text", "id": "title", "label": "Title", "default": "JUICE CUP NG-01 Portable Blender" },
        { "type": "text", "id": "price", "label": "Price", "default": "380.00" },
        { "type": "url", "id": "url", "label": "Product URL" }
      ]
    }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
